{
  "include": [
    "index.js",
    "./src/**/*",
    "./node_modules/**.*",
    "./types/**/*"
  ],
  "compilerOptions": {
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowUmdGlobalAccess": true,
    "maxNodeModuleJsDepth": 3,
    "paths": {
      "*": ["./typescript/node_modules/*"]
    }
  }
}
